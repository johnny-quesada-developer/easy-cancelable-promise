# Public site configuration. Committed on purpose: this is an open-source project and nothing here is
# secret. Only PUBLIC_* variables are exposed to the site (Astro/Vite bake them in at build time).
# Read through src/lib/site.ts; astro.config.mjs reads the site URL and base path from here too.

# Deployment (GitHub Pages project site: https://johnny-quesada-developer.github.io/easy-cancelable-promise/)
PUBLIC_SITE_URL=https://johnny-quesada-developer.github.io
PUBLIC_BASE_PATH=/easy-cancelable-promise

PUBLIC_SITE_NAME=easy-cancelable-promise

# The library version these docs and examples describe (the built package in libs/easy-cancelable-promise/dist).
# Written by `yarn version-bump`; do not edit by hand.
PUBLIC_PACKAGE_VERSION=3.0.0-beta.0

# External links
PUBLIC_REPO_URL=https://github.com/johnny-quesada-developer/easy-cancelable-promise
PUBLIC_NPM_URL=https://www.npmjs.com/package/easy-cancelable-promise
PUBLIC_EASY_WEB_WORKER_URL=https://johnny-quesada-developer.github.io/easy-web-worker/
PUBLIC_GLOBAL_STATE_HOOKS_URL=https://johnny-quesada-developer.github.io/react-global-state-hooks/
PUBLIC_JSON_STORAGE_FORMATTER_URL=https://github.com/johnny-quesada-developer/json-storage-formatter
PUBLIC_GITHUB_PROFILE_URL=https://github.com/johnny-quesada-developer
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/quesada-react-angular-typescript-developer/
