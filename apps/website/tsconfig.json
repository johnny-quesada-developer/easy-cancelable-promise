{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "astro.config.mjs", "vitest.config.ts", "playwright.config.ts", "visual"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@snippets/*": ["src/snippets/*"],
      "@examples/*": ["src/examples/*"],
      "easy-cancelable-promise": ["../../libs/easy-cancelable-promise/dist/index.d.ts"],
      "easy-cancelable-promise/*": ["../../libs/easy-cancelable-promise/dist/*"]
    }
  }
}
