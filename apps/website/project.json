{
  "name": "website",
  "sourceRoot": "apps/website/src",
  "projectType": "application",
  "tags": [
    "scope:website",
    "type:app"
  ],
  "//": "Deployed to GitHub Pages by .github/workflows/deploy-website.yml. Never published to npm. Every target builds the package first: the site runs against libs/easy-cancelable-promise/dist.",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn dev",
        "cwd": "apps/website"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "yarn build",
        "cwd": "apps/website"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn preview",
        "cwd": "apps/website"
      },
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn test",
        "cwd": "apps/website"
      }
    },
    "test:visual": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn test:visual",
        "cwd": "apps/website"
      }
    },
    "test:visual:update": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn test:visual:update",
        "cwd": "apps/website"
      }
    },
    "ts-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn ts-check",
        "cwd": "apps/website"
      }
    },
    "check:links": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn check:links",
        "cwd": "apps/website"
      },
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ]
    },
    "test:visual:run": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn test:visual:run",
        "cwd": "apps/website"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn lint",
        "cwd": "apps/website"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "//": "Runs after the validation of the library, against the dist that run just built. Never cached.",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "validate"
        }
      ],
      "options": {
        "command": "yarn validate",
        "cwd": "apps/website"
      }
    },
    "test:debug": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "easy-cancelable-promise"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "yarn test:debug",
        "cwd": "apps/website"
      }
    }
  },
  "implicitDependencies": [
    "easy-cancelable-promise"
  ]
}
