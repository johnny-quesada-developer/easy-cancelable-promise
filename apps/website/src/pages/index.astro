---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CancelDemo } from '../examples/cancel/CancelDemo';
import { ProgressDemo } from '../examples/progress/ProgressDemo';
import { GroupDemo } from '../examples/group/GroupDemo';
import { CodeBlock } from '../ui/CodeBlock';
import { Icon } from '../ui/Icon';
import { ButtonLink } from '../ui/Button';
import { withBase } from '../lib/site';
// The code on this page is the code of the README, kept as real files: src/lib/readme.test.ts compares them.
import promiseCompatible from '@snippets/home/promise-compatible.ts?raw';
import solution from '@snippets/home/solution.ts?raw';
import executorUtilities from '@snippets/home/executor-utilities.ts?raw';

const gettingStarted = withBase('docs/getting-started/');
const install = 'npm install easy-cancelable-promise';

const essentials = [
  {
    icon: 'sliders',
    title: 'Resolve it from anywhere.',
    text: '<code>defer()</code> returns the promise with its <code>resolve</code>, <code>reject</code> and <code>cancel</code> outside the callback. Made for events, queues and tests.',
    link: 'Use deferred promises',
    href: withBase('docs/defer/'),
    tone: 'border-[#e7ecdf] dark:border-line bg-[#f5f7f2] dark:bg-soft text-[#718563] dark:text-muted',
  },
  {
    icon: 'layers',
    title: 'Promise.all, cancelable.',
    text: '<code>all</code>, <code>allSettled</code> and <code>race</code> return a promise you can cancel, and canceling it cancels every promise inside.',
    link: 'See the static helpers',
    href: withBase('docs/static-helpers/'),
    tone: 'border-[#ece7db] dark:border-line bg-[#f8f6f0] dark:bg-soft text-[#887859] dark:text-amber',
  },
  {
    icon: 'branch',
    title: 'Your existing promises, too.',
    text: '<code>toCancelablePromise</code> accepts a native promise, a value or a function, and gives back a promise with a status and a <code>cancel</code> method.',
    link: 'Convert native promises',
    href: withBase('docs/converting-native-promises/'),
    tone: 'border-[#e8e5ef] dark:border-line bg-[#f5f4f8] dark:bg-blue-soft text-[#7b7897] dark:text-blue',
  },
] as const;

const questions = [
  {
    q: 'Is it a real Promise?',
    a: 'Yes. <code>CancelablePromise</code> extends the native <code>Promise</code>. It works with <code>async</code> / <code>await</code>, <code>then</code>, <code>catch</code>, <code>Promise.all</code> and any code that expects a promise.',
  },
  {
    q: 'Does canceling always stop the work?',
    a: `Canceling tells everyone to stop waiting. The work stops when the promise has an <code>onCancel</code> listener that stops it: clears the timer, aborts the request. <a class="underline underline-offset-[3px]" href="${withBase('docs/cancel-and-oncancel/')}">How cancellation works</a>.`,
  },
  {
    q: 'What does await see when a promise is canceled?',
    a: `A rejection with the reason you passed to <code>cancel</code>. The <code>status</code> of the promise is <code>'canceled'</code>, so a cancellation can be told from a failure, and canceling never causes an unhandled rejection.`,
  },
  {
    q: 'Does it depend on a framework or a runtime?',
    a: `No. It has zero dependencies and runs wherever <code>Promise</code> does, in browsers and in Node. <a class="underline underline-offset-[3px]" href="${withBase('docs/platform-and-versions/')}">Platform and versions</a>.`,
  },
];

const textLink = 'inline-flex items-center gap-[9px] text-14 font-[550] text-ink hover:text-green [&_.arrow]:transition-transform [&_.arrow]:duration-200 hover:[&_.arrow]:translate-x-[3px]';
const installCopy =
  'mx-auto mt-[17px] flex w-fit items-center justify-center gap-3 rounded-[5px] px-[9px] py-[7px] font-mono text-11 leading-[1.4] text-muted hover:bg-soft hover:text-green max-sm:mt-3 max-sm:gap-[9px] max-sm:text-9';
const eyebrowLine = 'h-px w-[26px] bg-current';
const sectionTitle = 'mt-[18px] text-[calc(clamp(34px,3.55vw,49px)*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-lg:text-[calc(36px*var(--type-scale))] max-sm:mt-[15px] max-sm:text-[calc(35px*var(--type-scale))]';
const sectionText = 'mt-[22px] mb-0 max-w-[350px] text-15 leading-[1.85] text-muted max-lg:text-13 max-sm:mt-[19px] max-sm:max-w-[450px]';
const sectionNote = 'mt-[22px] mb-0 max-w-[350px] text-10 leading-[1.7] text-[#676c62] dark:text-muted max-sm:mt-[15px] max-sm:max-w-[440px] max-sm:text-9';
const stage = 'min-w-0 rounded-panel border border-line bg-soft p-[26px] max-lg:p-[18px] max-sm:p-[14px]';
const codeFrame = 'min-w-0 [&_.code-block]:m-0';
---

<BaseLayout
  image="og/home.png"
  imageAlt="easy-cancelable-promise: The cancelable promise you didn't know you needed."
  title="easy-cancelable-promise"
  description="The cancelable promise you didn't know you needed. Promises that respect boundaries: cancel what you don't need, track the status, report progress and clean up, with zero dependencies."
  family="Product"
>
  <section class="wrap pt-[65px] text-center max-2xl:pt-[53px] max-sm:pt-[42px]" aria-labelledby="hero-title">
    <a
      class="mx-auto flex w-fit min-h-[29px] items-center gap-[9px] rounded-full border border-line bg-surface py-1 pr-[10px] pl-[9px] text-11 text-[#4f5d54] dark:text-muted hover:border-[#b6c9bc] dark:hover:border-line max-sm:gap-[6px] max-sm:text-10"
      href="#live"
    >
      <span class="rounded-[20px] bg-[#e9f0e9] dark:bg-green-soft px-[6px] py-1 font-mono text-9 leading-[1.2] text-green max-sm:text-8">LIVE</span>
      Same work. Two promises.
      <Icon name="chevron" className="size-[13px] text-[#7b867e] dark:text-muted" />
    </a>
    <h1
      id="hero-title"
      class="mx-auto mt-6 mb-5 max-w-[1100px] text-[calc(clamp(56px,6.1vw,87px)*var(--type-scale))] leading-[1.025] font-[550] tracking-[-0.065em] max-2xl:text-[calc(76px*var(--type-scale))] max-lg:text-[calc(67px*var(--type-scale))] max-sm:mt-[23px] max-sm:mb-[18px] max-sm:text-[calc(clamp(39px,9.25vw,59px)*var(--type-scale))] max-sm:leading-[1.075] max-sm:tracking-[-0.06em] 4xl:text-[calc(91px*var(--type-scale))]"
    >
      The cancelable promise<br /><span class="text-[#464e48] dark:text-muted">you didn't know you needed.</span>
    </h1>
    <p class="mx-auto mb-0 max-w-[660px] text-17 leading-[1.75] tracking-[-0.2px] text-muted max-lg:max-w-[570px] max-lg:text-15 max-sm:max-w-[370px] max-sm:text-14 max-sm:leading-[1.8]">
      Promises that respect boundaries. Cancel what you don't need.
    </p>
    <p class="mx-auto mt-[14px] mb-0 max-w-[620px] text-13 leading-[1.8] text-[#6f796f] dark:text-muted max-lg:max-w-[540px] max-sm:max-w-[360px] max-sm:text-12">
      Native promises can't be canceled. Their status can't be tracked. Once started, they run to completion. Always.
    </p>
    <div class="mt-[26px] flex flex-wrap items-center justify-center gap-3 max-sm:mt-[22px] max-sm:gap-[9px]">
      <ButtonLink variant="primary" icon="arrow" className="min-h-12 px-[22px] text-14 max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href={gettingStarted}>Start building</ButtonLink>
      <a class="inline-flex min-h-12 items-center justify-center gap-3 rounded-control border border-line bg-paper px-[22px] text-14 font-[550] whitespace-nowrap hover:border-[#b7c2ba] dark:hover:border-line hover:bg-soft max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href="#live">
        <Icon name="play" className="size-[14px]" /> See it run
      </a>
    </div>
    <button type="button" class={installCopy} data-copy={install} aria-label="Copy npm install command">
      <span class="text-[#646c64] dark:text-muted">$</span><span>{install}</span><Icon name="copy" className="size-[13px] max-sm:size-3" />
    </button>

    <div class="mx-auto mt-[46px] grid grid-cols-2 gap-5 text-left max-lg:gap-[14px] max-sm:mt-[32px] max-sm:grid-cols-1">
      <div class={codeFrame}>
        <CodeBlock code={promiseCompatible.trimEnd()} lang="ts" title="promise-compatible.ts" />
      </div>
      <div class={codeFrame}>
        <CodeBlock code={solution.trimEnd()} lang="ts" title="solution.ts" />
      </div>
    </div>

    <div class="mt-[41px] flex flex-wrap items-center justify-center gap-[27px] border-b border-line pb-[51px] text-11 text-[#6f796f] dark:text-muted max-lg:gap-[17px] max-sm:mt-[30px] max-sm:gap-x-5 max-sm:gap-y-[13px] max-sm:pb-9 max-sm:text-9" aria-label="Library capabilities">
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="bolt" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> 100% Promise compatible</span>
      <span class="h-[13px] w-px bg-[#e2e7dd] dark:bg-line max-lg:hidden" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="check" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> TypeScript ready</span>
      <span class="h-[13px] w-px bg-[#e2e7dd] dark:bg-line max-lg:hidden" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="scope" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> Zero dependencies</span>
      <span class="h-[13px] w-px bg-[#e2e7dd] dark:bg-line max-lg:hidden" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="github" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> Open source · MIT</span>
    </div>
  </section>

  <section class="wrap grid grid-cols-[.72fr_1.45fr] items-center gap-[70px] py-[103px] max-2xl:grid-cols-1 max-2xl:gap-[34px] max-sm:gap-[30px] max-sm:py-[66px]" id="live" aria-labelledby="live-title">
    <div class="min-w-0">
      <div class="eyebrow-mono"><span class={eyebrowLine}></span> CANCELLATION</div>
      <h2 id="live-title" class={sectionTitle}>Stop waiting.<br />Stop the work too.</h2>
      <p class={sectionText}>The same work runs in a native promise and in a CancelablePromise. Press Stop. With the native promise you can only stop listening: every remaining step still runs. The CancelablePromise is told to stop, and it does.</p>
      <a class={`${textLink} mt-[25px] text-12 max-sm:mt-[18px]`} href={withBase('examples/stop-the-work/')}>Open the full example <Icon name="arrow" className="arrow" /></a>
      <p class={sectionNote}>This runs in your browser, against the same package files that are published to npm.</p>
    </div>
    <div class={stage}>
      <CancelDemo client:only="react">
        <p slot="fallback" class="m-0 grid min-h-[320px] place-items-center text-12 text-muted">Loading the live example…</p>
      </CancelDemo>
    </div>
  </section>

  <section class="wrap border-t border-line py-[103px] max-sm:py-[66px]" id="utilities" aria-labelledby="utilities-title">
    <div class="mb-[35px] flex items-end justify-between gap-[42px] max-2xl:gap-[30px] max-lg:block max-sm:mb-[27px]">
      <div>
        <div class="eyebrow-mono text-[#586b89] dark:text-blue"><span class={eyebrowLine}></span> EXECUTOR UTILITIES</div>
        <h2 id="utilities-title" class={sectionTitle}>The third parameter<br />gives you superpowers.</h2>
      </div>
      <div class="max-w-[400px] pb-[3px] max-2xl:max-w-[360px] max-lg:mt-[23px] max-lg:max-w-[520px] max-sm:mt-[18px]">
        <p class="m-0 text-15 leading-[1.85] text-muted max-sm:text-13 max-sm:leading-[1.9]">The core class that extends native Promise with cancellation and lifecycle management.</p>
        <a class={`${textLink} mt-[17px] text-12 max-sm:mt-[14px]`} href={withBase('docs/cancelable-promise/#the-callback')}>See every utility <Icon name="arrow" className="arrow" /></a>
      </div>
    </div>
    <div class={codeFrame}>
      <CodeBlock code={executorUtilities.trimEnd()} lang="ts" title="executor-utilities.ts" />
    </div>
  </section>

  <section class="wrap grid grid-cols-[1.45fr_.72fr] items-center gap-[70px] border-t border-line py-[103px] max-2xl:grid-cols-1 max-2xl:gap-[34px] max-sm:gap-[30px] max-sm:py-[66px]" id="progress" aria-labelledby="progress-title">
    <div class={stage}>
      <ProgressDemo client:only="react">
        <p slot="fallback" class="m-0 grid min-h-[320px] place-items-center text-12 text-muted">Loading the live example…</p>
      </ProgressDemo>
    </div>
    <div class="min-w-0 pl-[6px] max-2xl:order-first max-2xl:pl-0">
      <div class="eyebrow-mono"><span class={eyebrowLine}></span> PROGRESS</div>
      <h2 id="progress-title" class={sectionTitle}>Built-in<br />progress tracking.</h2>
      <p class={sectionText}>A native promise says one thing, at the end. A CancelablePromise reports while it works, and whoever holds it can listen. No extra libraries needed, and no second channel to carry around.</p>
      <a class={`${textLink} mt-[25px] text-12 max-sm:mt-[18px]`} href={withBase('docs/progress-reporting/')}>Report and track progress <Icon name="arrow" className="arrow" /></a>
      <p class={sectionNote}>The reports also reach the promises chained from it with then.</p>
    </div>
  </section>

  <section class="wrap grid grid-cols-[.72fr_1.45fr] items-center gap-[70px] border-t border-line py-[103px] max-2xl:grid-cols-1 max-2xl:gap-[34px] max-sm:gap-[30px] max-sm:py-[66px]" id="group" aria-labelledby="group-title">
    <div class="min-w-0">
      <div class="eyebrow-mono text-[#586b89] dark:text-blue"><span class={eyebrowLine}></span> GROUPS</div>
      <h2 id="group-title" class={sectionTitle}>Six tasks.<br />One cancel.</h2>
      <p class={sectionText}><code>groupAsCancelablePromise</code> runs a list of tasks with a concurrency limit and returns one promise. Cancel it and the running tasks stop, and the ones in the queue never start. A queue written with native promises keeps going.</p>
      <a class={`${textLink} mt-[25px] text-12 max-sm:mt-[18px]`} href={withBase('docs/groups-and-concurrency/')}>Group and limit concurrency <Icon name="arrow" className="arrow" /></a>
      <p class={sectionNote}>The results come back in the order of the tasks, whichever finishes first.</p>
    </div>
    <div class={stage}>
      <GroupDemo client:only="react">
        <p slot="fallback" class="m-0 grid min-h-[320px] place-items-center text-12 text-muted">Loading the live example…</p>
      </GroupDemo>
    </div>
  </section>

  <section class="wrap border-t border-line pt-[75px] pb-[84px] max-sm:py-[60px]" aria-labelledby="essentials-title">
    <div class="mb-[33px] flex items-end justify-between gap-[25px] max-sm:mb-[30px] max-sm:block">
      <h2 id="essentials-title" class="max-w-[400px] text-[calc(31px*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-sm:text-[calc(28px*var(--type-scale))]">Simple to start.<br />Room for the real world.</h2>
      <p class="m-0 max-w-[300px] text-12 text-[#656c61] dark:text-muted max-sm:mt-4 max-sm:max-w-[400px]">Begin with one promise. Reach for the rest only when the application needs it.</p>
    </div>
    <div class="grid grid-cols-3 gap-10 max-lg:gap-[19px] max-sm:flex max-sm:flex-col max-sm:gap-[27px]">
      {
        essentials.map((item) => (
          <article class="pr-5 [&+&]:border-l [&+&]:border-line [&+&]:pl-[30px] max-lg:pr-0 max-lg:[&+&]:pl-[21px] max-sm:relative max-sm:pr-0 max-sm:pb-6 max-sm:pl-[51px] max-sm:not-last:border-b max-sm:not-last:border-line max-sm:[&+&]:border-l-0 max-sm:[&+&]:pl-[51px]">
            <span class={`mb-4 grid size-[33px] place-items-center rounded-control border max-sm:absolute max-sm:top-0 max-sm:left-0 ${item.tone}`}>
              <Icon name={item.icon} className="size-[17px]" />
            </span>
            <h3 class="mb-[9px] text-16 font-[550] tracking-[-0.4px] max-lg:text-14 max-sm:text-15">{item.title}</h3>
            <p class="m-0 text-12 leading-[1.85] text-[#646d5d] dark:text-muted [&_code]:text-[0.9em] max-lg:text-11 max-sm:text-12" set:html={item.text} />
            <a class={`${textLink} mt-[15px] text-11 text-[#68775e] dark:text-muted max-sm:mt-[11px]`} href={item.href}>{item.link} <Icon name="arrow" className="arrow" /></a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap grid grid-cols-[.75fr_1.25fr] gap-[100px] border-t border-line pt-[67px] pb-20 max-2xl:gap-[65px] max-lg:grid-cols-[1fr_1.3fr] max-lg:gap-10 max-sm:grid-cols-1 max-sm:gap-[25px] max-sm:pt-[55px] max-sm:pb-[58px]" aria-labelledby="questions-title">
    <div>
      <h2 id="questions-title" class="text-[calc(29px*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-sm:text-[calc(27px*var(--type-scale))]">A few useful details.</h2>
      <p class="mt-[14px] mb-0 text-12 leading-[1.85] text-muted max-sm:mt-[10px]">No mystery around the small print.</p>
    </div>
    <div>
      {
        questions.map((item) => (
          <details class="border-b border-line first:border-t [&[open]_.icon]:rotate-45">
            <summary class="flex cursor-pointer items-center justify-between gap-[25px] py-[18px] text-12 font-medium max-sm:gap-[14px]">
              {item.q}
              <Icon name="plus" className="size-[13px] text-[#8a947f] dark:text-muted" />
            </summary>
            <p class="m-0 pb-[18px] text-12 leading-[1.9] text-muted [&_code]:text-10 max-sm:text-11" set:html={item.a} />
          </details>
        ))
      }
    </div>
  </section>

  <aside class="wrap flex items-center justify-between gap-8 rounded-[9px] border border-line bg-[#fbfcf9] dark:bg-surface px-8 py-[27px] max-sm:block max-sm:p-[22px]" aria-label="Project maintainer">
    <div class="flex items-center gap-[17px] max-sm:gap-[13px]">
      <span class="grid size-[45px] shrink-0 place-items-center overflow-hidden rounded-full border border-[#dde5d4] dark:border-line bg-[#eef3e7] dark:bg-green-soft max-sm:size-[37px]" aria-hidden="true">
        <img class="block size-full object-cover" src={withBase('img/avatar-head.png')} width="45" height="45" alt="" loading="lazy" decoding="async" />
      </span>
      <div>
        <h3 class="text-13 font-[550] tracking-normal max-sm:text-11">Independent software. Accountable craftsmanship.</h3>
        <p class="mt-[3px] mb-0 text-11 text-[#656d5c] dark:text-muted max-sm:text-10 max-sm:leading-[1.8]">Created and maintained by Johnny Quesada. Open code, real examples, and a direct line to the builder.</p>
      </div>
    </div>
    <a class={`${textLink} text-11 whitespace-nowrap max-sm:mt-[15px] max-sm:ml-[50px] max-sm:text-10`} href={withBase('about/')}>Meet the engineer <Icon name="up-right" className="arrow" /></a>
  </aside>

  <section class="wrap pt-24 pb-[86px] text-center max-sm:pt-[68px] max-sm:pb-[62px]" aria-labelledby="closing-title">
    <div class="eyebrow-mono justify-center">CLEAN. SIMPLE.</div>
    <h2 id="closing-title" class="mt-[15px] text-[calc(clamp(35px,4.1vw,56px)*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-sm:text-[calc(37px*var(--type-scale))]">Your promises,<br />your control.</h2>
    <p class="mt-[17px] mb-0 text-14 text-[#646d5d] dark:text-muted max-sm:mt-[15px] max-sm:text-12">The promise handles its own cleanup. Cancel from anywhere, anytime.</p>
    <div class="mt-[25px] flex flex-wrap items-center justify-center gap-3 max-sm:mt-[22px] max-sm:gap-[9px]">
      <ButtonLink variant="primary" icon="arrow" className="min-h-12 px-[22px] text-14 max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href={gettingStarted}>Get started</ButtonLink>
      <ButtonLink icon="arrow" className="min-h-12 px-[22px] text-14 max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href={withBase('examples/')}>Explore the examples</ButtonLink>
    </div>
    <button type="button" class={`${installCopy} mt-[14px]`} data-copy={install} aria-label="Copy npm install command">
      <span class="text-[#646c64] dark:text-muted">$</span><span>{install}</span><Icon name="copy" className="size-[13px] max-sm:size-3" />
    </button>
  </section>
</BaseLayout>
