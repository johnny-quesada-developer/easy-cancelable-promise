---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocsHub } from '../../ui/docs/DocsHub';
import { getDocsNav } from '../../lib/docs';

const { sections } = await getDocsNav();
const hubSections = sections.map((section) => ({
  title: section.title,
  pages: section.pages.map((page) => ({ id: page.id, title: page.data.title, description: page.data.description })),
}));
---

<BaseLayout
  image="og/docs.png"
  imageAlt="easy-cancelable-promise documentation"
  title="Cancelable promise guides and API reference"
  description="Learn promise cancellation, cleanup, progress reporting, deferred promises, and task concurrency with easy-cancelable-promise guides and API reference."
>
  <DocsHub sections={hubSections} />
</BaseLayout>
